{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      "$env": {
        ".read": "$env === 'staging' || $env === 'angular' || $env === 'prod'",
        "$tab": {
          ".write": "$tab.length <= 40",
          ".validate": "newData.hasChildren(['t', 'page']) && newData.child('t').isNumber() && (newData.child('page').val() === 'home' || newData.child('page').val() === 'view')",
          "t": { ".validate": "newData.val() <= now + 60000" },
          "page": { ".validate": "newData.isString()" },
          "$other": { ".validate": false }
        }
      }
    },
    "visits": {
      "$env": {
        "$day": {
          ".read": "$env === 'staging' || $env === 'angular' || $env === 'prod'",
          "$id": {
            ".write": "!data.exists() && $id.length <= 40 && $day.matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/)",
            ".validate": "newData.isBoolean()"
          }
        }
      }
    }
  }
}
