{
  "name": "docs-viewer",
  "version": "1.0.0",
  "description": "Document viewer that runs entirely in the browser: PDF, Word (.docx, .docm, .doc), Excel (.xlsx, .xlsm, .xls, .csv), PowerPoint (.pptx, .ppt), JPEG, TIFF and text. No document leaves the page.",
  "author": "Venu Madhav Mahadevu",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "main": "./dist/docs-viewer.js",
  "module": "./dist/docs-viewer.js",
  "exports": {
    ".": "./dist/docs-viewer.js",
    "./style.css": "./dist/docs-viewer.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "prepare": "node scripts/copy-pdfjs-assets.mjs && node scripts/copy-fonts.mjs",
    "predev": "node scripts/copy-pdfjs-assets.mjs && node scripts/copy-fonts.mjs",
    "dev": "vite --open /demo/",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs && node scripts/copy-fonts.mjs",
    "build": "vite build",
    "test": "node test/library.test.cjs"
  },
  "dependencies": {
    "cfb": "^1.2.2",
    "docx-preview": "^0.4.1",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^6.4.299",
    "utif": "^3.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@fontsource/arimo": "^5.3.0",
    "@fontsource/caladea": "^5.3.0",
    "@fontsource/carlito": "^5.3.0",
    "@fontsource/cousine": "^5.3.0",
    "@fontsource/tinos": "^5.3.0",
    "playwright": "^1.62.0",
    "vite": "^8.3.4"
  }
}
